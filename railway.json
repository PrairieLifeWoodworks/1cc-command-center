{
    "$schema": "https://schema.railway.app/railway-config.json",
    "build": {
          "builder": "NIXPACKS",
          "buildCommand": "npm run build"
    },
    "deploy": {
          "startCommand": "node apps/api/dist/index.js",
          "healthcheckPath": "/health",
          "restartPolicyType": "ON_FAILURE",
          "restartPolicyMaxRetries": 3
    }
}
